#include <winver.h>

1                       24      "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x00040004L
FILETYPE 0x00000001L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Unofficial Mini vMac custom build\0"
            VALUE "FileDescription", "Mini vMac Plus\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "MiniVmacPlus\0"
            VALUE "OriginalFilename", "minivmac-plus.exe\0"
            VALUE "ProductName", "Mini vMac Plus\0"
            VALUE "ProductVersion", "0.1.0.0\0"
            VALUE "Comments", "Custom Windows-oriented Mini vMac build. Does not include ROM or disk images.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
